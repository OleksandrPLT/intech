---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import TechStack from '../components/TechStack.astro';
import { useTranslations, localeUrl } from '../i18n/utils';

const lang = 'uk' as const;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('meta.about.title')} description={t('meta.about.description')}>
	<section class="section about-hero">
		<div class="container">
			<span class="eyebrow">{t('about.eyebrow')}</span>
			<h1>{t('about.name')}</h1>
			<p class="about-hero__role">{t('about.title')}</p>
		</div>
	</section>

	<section class="section section--tight">
		<div class="container about-text">
			<p>{t('about.p1')}</p>
			<p>{t('about.p2')}</p>
		</div>
	</section>

	<section class="section section--tight about-skills">
		<div class="container">
			<h2>{t('about.stackTitle')}</h2>
			<TechStack lang={lang} />
		</div>
	</section>

	<section class="section section--tight">
		<div class="container about-cta">
			<a href={localeUrl(lang, '/contact')} class="btn btn--primary">{t('home.hero.ctaPrimary')}</a>
		</div>
	</section>
</BaseLayout>

<style>
	h1 {
		font-size: clamp(32px, 4.6vw, 48px);
		margin-top: 16px;
		margin-bottom: 4px;
		max-width: 700px;
	}

	.about-hero__role {
		font-family: var(--font-mono);
		font-size: 15px;
		color: var(--muted);
		margin: 0;
	}

	.about-text {
		max-width: 680px;
	}

	.about-text p {
		font-size: 17px;
		color: var(--paper);
	}

	.about-skills {
		border-top: 1px solid var(--border);
	}

	.about-skills h2 {
		font-size: 22px;
		margin-bottom: 32px;
	}
</style>
