---
import { eq } from 'drizzle-orm';
import AppLayout from '../../../../layouts/AppLayout.astro';
import { db } from '../../../../db/client';
import { projects } from '../../../../db/schema';
import { ticketCategories } from '../../../../lib/ticketCategories';

const user = Astro.locals.user!;
const myProjects = db.select().from(projects).where(eq(projects.clientId, user.id)).all();
const preselected = Astro.url.searchParams.get('projectId');
const error = Astro.url.searchParams.get('error');
---

<AppLayout user={user} title="Новий тікет">
	<div class="app-header">
		<h1>Новий тікет</h1>
		<a href="/app/client/tickets" class="btn btn--ghost">← Усі тікети</a>
	</div>

	{
		myProjects.length === 0 ? (
			<p class="card" style="padding: 20px; color: var(--muted);">
				У вас ще немає прив'язаних проектів, тому тікет створити нема куди.
			</p>
		) : (
			<>
				{error && <p class="form-error" style="margin-bottom: 14px; max-width: 520px;">Заповніть усі поля.</p>}
				<form method="POST" action="/api/tickets" enctype="multipart/form-data" class="card" style="padding: 20px; max-width: 560px; display: flex; flex-direction: column; gap: 12px;">
					<div class="field">
						<label for="projectId">Проект</label>
						<select id="projectId" name="projectId" required>
							{myProjects.map((p) => (
								<option value={p.id} selected={String(p.id) === preselected}>
									{p.name}
								</option>
							))}
						</select>
					</div>

					<div class="field">
						<label>Тема звернення — оберіть, що потрібно</label>
						<div style="display: flex; flex-wrap: wrap; gap: 8px;">
							{ticketCategories.map((c, i) => (
								<label style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid var(--border); border-radius: 999px; font-size: 13px; cursor: pointer;">
									<input type="radio" name="category" value={c.code} checked={i === ticketCategories.length - 1} style="width: 14px; height: 14px;" />
									{c.label}
								</label>
							))}
						</div>
					</div>

					<div class="field">
						<label for="subject">Тема</label>
						<input type="text" id="subject" name="subject" required />
					</div>
					<div class="field">
						<label for="body">Повідомлення</label>
						<textarea id="body" name="body" required />
					</div>
					<div class="field">
						<label for="attachment">Файл (необов'язково, до 10 МБ)</label>
						<input type="file" id="attachment" name="attachment" />
					</div>
					<button type="submit" class="btn btn--primary" style="justify-content: center;">Створити тікет</button>
				</form>
			</>
		)
	}
</AppLayout>
