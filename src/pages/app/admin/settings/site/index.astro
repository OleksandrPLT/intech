---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { getSiteSetting } from '../../../../../lib/siteSettings';
import { mailerIsConfigured } from '../../../../../lib/mailer';

const user = Astro.locals.user!;
const email = getSiteSetting('contact.email', '');
const telegram = getSiteSetting('contact.telegram', '');
const phoneUa = getSiteSetting('contact.phoneUa', '');
const phoneEe = getSiteSetting('contact.phoneEe', '');

const smtpHost = getSiteSetting('smtp.host', '');
const smtpPort = getSiteSetting('smtp.port', '587');
const smtpUser = getSiteSetting('smtp.user', '');
const smtpFrom = getSiteSetting('smtp.from', '');
const smtpSecure = getSiteSetting('smtp.secure', '0') === '1';
const smtpHasPassword = getSiteSetting('smtp.pass', '') !== '';

const saved = Astro.url.searchParams.get('saved');
const test = Astro.url.searchParams.get('test');
const testError = Astro.url.searchParams.get('testError');
const smtpOn = mailerIsConfigured();
---

<AppLayout user={user} title="Налаштування сайту">
	<div class="app-header">
		<h1>Налаштування</h1>
	</div>

	<div class="settings-links">
		<a href="/app/settings/profile" class="card settings-link">
			<strong>Мій профіль</strong>
			<span>Ім'я, email, пароль</span>
		</a>
		<a href="/app/admin/settings/fields" class="card settings-link">
			<strong>Власні поля</strong>
			<span>Ліди, проекти, клієнти</span>
		</a>
		<a href="/app/admin/api-keys" class="card settings-link">
			<strong>API-ключі</strong>
			<span>Інтеграції клієнтських проектів</span>
		</a>
	</div>

	{saved && <p style="color: var(--accent); font-size: 14px; margin-bottom: 16px;">Збережено.</p>}

	<div class="settings-grid">
		<div class="card" style="padding: 16px;">
			<h2 style="font-size: 15px; margin: 0 0 4px;">Контакти на сайті</h2>
			<p style="font-size: 13px; color: var(--muted); margin: 0 0 16px;">
				Показуються на сторінці "Контакти" (усіма мовами) замість плейсхолдерів
				<code>[EMAIL]</code> / <code>[TELEGRAM]</code>.
			</p>
			<form method="POST" action="/api/admin/site-settings" style="display: flex; flex-direction: column; gap: 12px;">
				<div class="field">
					<label for="email">Email</label>
					<input type="email" id="email" name="email" value={email} placeholder="you@intech.org.ua" />
				</div>
				<div class="field">
					<label for="telegram">Telegram (нік без @)</label>
					<input type="text" id="telegram" name="telegram" value={telegram} placeholder="yourusername" />
				</div>
				<div class="field">
					<label for="phoneUa">Телефон (Україна)</label>
					<input type="tel" id="phoneUa" name="phoneUa" value={phoneUa} placeholder="+380 XX XXX XX XX" data-phone-mask />
				</div>
				<div class="field">
					<label for="phoneEe">Телефон (Естонія)</label>
					<input type="tel" id="phoneEe" name="phoneEe" value={phoneEe} placeholder="+372 XXXX XXXX" />
				</div>
				<button type="submit" class="btn btn--primary" style="align-self: flex-start; padding: 9px 20px; font-size: 13px;">Зберегти</button>
			</form>
		</div>

		<div class="card" style="padding: 16px;">
			<h2 style="font-size: 15px; margin: 0 0 4px;">Пошта (SMTP)</h2>
			<p style="font-size: 13px; color: var(--muted); margin: 0 0 12px;">
				Лист-запрошення новому клієнту та сповіщення про нові тікети йдуть через це. Поки не
				задано — листи не губляться, а зберігаються у <code>data/emails/</code>.
			</p>

			<p style="font-size: 13px; margin: 0 0 14px;">
				Статус:{' '}
				{
					smtpOn ? (
						<span class="badge badge--accent">SMTP налаштовано</span>
					) : (
						<span class="badge badge--muted">не налаштовано — листи у файли</span>
					)
				}
			</p>

			<form method="POST" action="/api/admin/smtp-settings" style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px;">
				<div style="display: flex; gap: 10px;">
					<div class="field" style="flex: 2;">
						<label for="host">Хост</label>
						<input type="text" id="host" name="host" value={smtpHost} placeholder="smtp.gmail.com" />
					</div>
					<div class="field" style="flex: 1;">
						<label for="port">Порт</label>
						<input type="text" id="port" name="port" value={smtpPort} placeholder="587" />
					</div>
				</div>
				<div class="field">
					<label for="smtpUser">Користувач</label>
					<input type="text" id="smtpUser" name="user" value={smtpUser} placeholder="you@intech.org.ua" />
				</div>
				<div class="field">
					<label for="pass">Пароль {smtpHasPassword && <span style="color: var(--muted); text-transform: none;">(вже збережено — залиште порожнім, щоб не змінювати)</span>}</label>
					<input type="password" id="pass" name="pass" placeholder={smtpHasPassword ? '••••••••' : ''} />
				</div>
				<div class="field">
					<label for="from">Відправник (From)</label>
					<input type="text" id="from" name="from" value={smtpFrom} placeholder="intech.org.ua <you@intech.org.ua>" />
				</div>
				<label style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted);">
					<input type="checkbox" name="secure" value="1" checked={smtpSecure} style="width: 15px; height: 15px;" />
					SSL/TLS (зазвичай увімкнено для порту 465)
				</label>
				<button type="submit" class="btn btn--primary" style="align-self: flex-start; padding: 9px 20px; font-size: 13px;">Зберегти SMTP</button>
			</form>

			{
				test === 'sent' && (
					<p style="color: var(--accent); font-size: 13px; margin-bottom: 10px;">Тестовий лист надіслано на {user.email}.</p>
				)
			}
			{
				test === 'logged' && (
					<p style="color: var(--muted); font-size: 13px; margin-bottom: 10px;">
						SMTP не налаштовано — тестовий лист збережено у <code>data/emails/</code>.
					</p>
				)
			}
			{
				test === 'failed' && (
					<p class="form-error" style="font-size: 13px; margin-bottom: 10px;">
						Не вдалося надіслати: {testError ?? 'невідома помилка'}. Перевірте хост/порт/пароль.
					</p>
				)
			}
			<form method="POST" action="/api/admin/test-email">
				<button type="submit" class="btn btn--ghost" style="padding: 7px 14px; font-size: 13px;">Надіслати тестовий лист</button>
			</form>
		</div>
	</div>
</AppLayout>

<script>
	// Same Ukrainian phone mask as ClientProfileFields.astro / the project contacts block.
	document.querySelectorAll<HTMLInputElement>('input[data-phone-mask]').forEach((input) => {
		input.addEventListener('input', () => {
			let digits = input.value.replace(/\D/g, '');
			if (!digits) {
				input.value = '';
				return;
			}
			if (digits.startsWith('0')) digits = '380' + digits.slice(1);
			else if (!digits.startsWith('380')) digits = '380' + digits;
			digits = digits.slice(0, 12);

			const rest = digits.slice(3);
			let formatted = '+380';
			if (rest.length) formatted += ' ' + rest.slice(0, 2);
			if (rest.length > 2) formatted += ' ' + rest.slice(2, 5);
			if (rest.length > 5) formatted += ' ' + rest.slice(5, 7);
			if (rest.length > 7) formatted += ' ' + rest.slice(7, 9);
			input.value = formatted;
		});
	});
</script>

<style>
	.settings-links {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 14px;
	}

	.settings-link {
		padding: 14px 16px;
		display: flex;
		flex-direction: column;
		gap: 3px;
		flex: 1;
		min-width: 180px;
		color: var(--paper);
	}

	.settings-link:hover {
		border-color: var(--accent);
	}

	.settings-link strong {
		font-size: 14px;
	}

	.settings-link span {
		font-size: 12px;
		color: var(--muted);
	}

	.settings-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
		align-items: start;
	}

	@media (max-width: 860px) {
		.settings-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
