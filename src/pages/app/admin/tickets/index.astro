---
import { desc, eq } from 'drizzle-orm';
import AppLayout from '../../../../layouts/AppLayout.astro';
import { db } from '../../../../db/client';
import { tickets, projects } from '../../../../db/schema';
import { ticketStatusLabels } from '../../../../lib/labels';
import { formatTicketNumber } from '../../../../lib/ticketNumber';
import { ticketCategoryLabels } from '../../../../lib/ticketCategories';

const user = Astro.locals.user!;

const allTickets = db
	.select({
		id: tickets.id,
		subject: tickets.subject,
		status: tickets.status,
		category: tickets.category,
		number: tickets.number,
		updatedAt: tickets.updatedAt,
		projectName: projects.name,
	})
	.from(tickets)
	.leftJoin(projects, eq(tickets.projectId, projects.id))
	.orderBy(desc(tickets.updatedAt))
	.all();
---

<AppLayout user={user} title="Тікети">
	<div class="app-header">
		<h1>Тікети</h1>
	</div>

	<div class="card table-wrap">
		<table class="data-table">
			<thead>
				<tr>
					<th>№</th>
					<th>Тема</th>
					<th>Проект</th>
					<th>Статус</th>
					<th>Оновлено</th>
				</tr>
			</thead>
			<tbody>
				{
					allTickets.length === 0 ? (
						<tr>
							<td colspan="5" style="color: var(--muted);">
								Тікетів ще немає.
							</td>
						</tr>
					) : (
						allTickets.map((t) => (
							<tr class="ticket-row" data-ticket-id={t.id} tabindex="0">
								<td style="font-family: var(--font-mono); font-size: 12px; color: var(--accent);" title={ticketCategoryLabels[t.category]}>
									{formatTicketNumber(t.category, t.number)}
								</td>
								<td>
									<a href={`/app/admin/tickets/${t.id}`} class="ticket-row__link">{t.subject}</a>
								</td>
								<td>{t.projectName}</td>
								<td>
									<span class="badge">{ticketStatusLabels[t.status] ?? t.status}</span>
								</td>
								<td>{new Date(t.updatedAt).toLocaleString('uk-UA')}</td>
							</tr>
						))
					)
				}
			</tbody>
		</table>
	</div>

	<dialog id="ticket-modal" class="ticket-modal">
		<div class="ticket-modal__inner">
			<button type="button" class="ticket-modal__close" id="ticket-modal-close" aria-label="Закрити">✕</button>
			<div id="ticket-modal-body" class="ticket-modal__body">
				<p style="color: var(--muted); font-size: 14px;">Завантаження…</p>
			</div>
		</div>
	</dialog>
</AppLayout>

<style>
	.ticket-row {
		cursor: pointer;
	}

	.ticket-row:hover {
		background: var(--ink-softer);
	}

	.ticket-row:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}

	.ticket-row__link:hover {
		color: var(--accent);
	}

	.ticket-modal {
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--ink-soft);
		color: var(--paper);
		padding: 0;
		width: min(680px, 92vw);
		max-height: min(84vh, 780px);
	}

	.ticket-modal::backdrop {
		background: color-mix(in srgb, var(--ink) 70%, transparent);
		backdrop-filter: blur(2px);
	}

	.ticket-modal__inner {
		position: relative;
		padding: 18px;
		max-height: min(84vh, 780px);
		overflow-y: auto;
	}

	.ticket-modal__close {
		position: sticky;
		top: 0;
		float: right;
		margin: -8px -8px 8px auto;
		background: var(--ink-softer);
		border: 1px solid var(--border);
		color: var(--muted);
		width: 30px;
		height: 30px;
		border-radius: 999px;
		cursor: pointer;
		font-size: 13px;
	}

	.ticket-modal__close:hover {
		color: var(--paper);
		border-color: var(--accent);
	}

	@media (max-width: 620px) {
		.ticket-modal {
			width: 96vw;
		}
		.ticket-modal__inner {
			padding: 18px;
		}
	}
</style>

<script>
	const modal = document.getElementById('ticket-modal') as HTMLDialogElement | null;
	const modalBody = document.getElementById('ticket-modal-body');
	const closeBtn = document.getElementById('ticket-modal-close');

	async function openTicket(id: string) {
		if (!modal || !modalBody) return;
		modalBody.innerHTML = '<p style="color: var(--muted); font-size: 14px;">Завантаження…</p>';
		modal.showModal();
		try {
			const res = await fetch(`/app/admin/tickets/${id}?partial=1`);
			modalBody.innerHTML = res.ok
				? await res.text()
				: '<p style="color: var(--muted); font-size: 14px;">Не вдалося завантажити тікет.</p>';
		} catch {
			modalBody.innerHTML = '<p style="color: var(--muted); font-size: 14px;">Не вдалося завантажити тікет.</p>';
		}
	}

	document.querySelectorAll<HTMLTableRowElement>('.ticket-row').forEach((row) => {
		row.addEventListener('click', (e) => {
			// A plain click on the subject <a> still works with JS disabled
			// (real navigation) — here we intercept it to open the modal instead.
			e.preventDefault();
			const id = row.dataset.ticketId;
			if (id) openTicket(id);
		});
		row.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') {
				const id = row.dataset.ticketId;
				if (id) openTicket(id);
			}
		});
	});

	closeBtn?.addEventListener('click', () => modal?.close());

	// Click on the backdrop (the padding area of <dialog> outside .ticket-modal__inner) closes it.
	modal?.addEventListener('click', (e) => {
		if (e.target === modal) modal.close();
	});
</script>
