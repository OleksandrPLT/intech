---
import AppLayout from '../../../../../layouts/AppLayout.astro';

const user = Astro.locals.user!;
const error = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
	invalid: "Вкажіть slug і дату.",
	image: 'Не вдалося завантажити зображення (максимум 5 МБ).',
};

const today = new Date().toISOString().slice(0, 10);
const icons = ['launch', 'globe', 'default'];
---

<AppLayout user={user} title="Новий пост">
	<div class="app-header">
		<h1>Новий пост</h1>
		<a href="/app/admin/content/news" class="btn btn--ghost">← Усі новини</a>
	</div>

	{error && <p class="form-error" style="margin-bottom: 14px; max-width: 640px;">{errorMessages[error] ?? 'Сталася помилка.'}</p>}

	<form method="POST" action="/api/admin/news" enctype="multipart/form-data" class="card" style="padding: 20px; max-width: 640px; display: flex; flex-direction: column; gap: 14px;">
		<div style="display: flex; gap: 12px;">
			<div class="field" style="flex: 1;">
				<label for="slug">Slug (латиницею, напр. site-launch)</label>
				<input type="text" id="slug" name="slug" required />
			</div>
			<div class="field" style="flex: 1;">
				<label for="date">Дата</label>
				<input type="date" id="date" name="date" value={today} required />
			</div>
		</div>

		<div class="field">
			<label for="image">Фото обкладинки (необов'язково)</label>
			<input type="file" id="image" name="image" accept="image/*" />
		</div>
		<div class="field">
			<label for="icon">Або згенерована обкладинка за іконкою</label>
			<select id="icon" name="icon">
				<option value="">— без іконки —</option>
				{icons.map((i) => (
					<option value={i}>{i}</option>
				))}
			</select>
		</div>

		{
			(['uk', 'en', 'et'] as const).map((lang) => (
				<details open={lang === 'uk'} class="card" style="padding: 16px;">
					<summary style="cursor: pointer; font-family: var(--font-mono); font-size: 13px; color: var(--accent);">
						{lang.toUpperCase()}
					</summary>
					<div style="display: flex; flex-direction: column; gap: 14px; margin-top: 16px;">
						<div class="field">
							<label for={`title_${lang}`}>Заголовок</label>
							<input type="text" id={`title_${lang}`} name={`title_${lang}`} required />
						</div>
						<div class="field">
							<label for={`excerpt_${lang}`}>Короткий опис</label>
							<textarea id={`excerpt_${lang}`} name={`excerpt_${lang}`} required />
						</div>
						<div class="field">
							<label for={`body_${lang}`}>Текст (абзаци — порожній рядок між ними)</label>
							<textarea id={`body_${lang}`} name={`body_${lang}`} rows="8" required />
						</div>
						<div class="field">
							<label for={`metaTitle_${lang}`}>SEO заголовок (необов'язково — інакше береться заголовок)</label>
							<input type="text" id={`metaTitle_${lang}`} name={`metaTitle_${lang}`} />
						</div>
						<div class="field">
							<label for={`metaDescription_${lang}`}>SEO опис (необов'язково — інакше береться короткий опис)</label>
							<textarea id={`metaDescription_${lang}`} name={`metaDescription_${lang}`} rows="2" />
						</div>
					</div>
				</details>
			))
		}

		<button type="submit" class="btn btn--primary" style="align-self: flex-start;">Опублікувати</button>
	</form>
</AppLayout>
