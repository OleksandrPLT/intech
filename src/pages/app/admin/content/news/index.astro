---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { sortedNews } from '../../../../../data/news';

const user = Astro.locals.user!;
const items = sortedNews();
---

<AppLayout user={user} title="Новини">
	<div class="app-header">
		<h1>Новини</h1>
		<a href="/app/admin/content/news/new" class="btn btn--primary">+ Новий пост</a>
	</div>

	<div class="card table-wrap">
		<table class="data-table">
			<thead>
				<tr>
					<th>Заголовок (UA)</th>
					<th>Slug</th>
					<th>Дата</th>
				</tr>
			</thead>
			<tbody>
				{
					items.length === 0 ? (
						<tr>
							<td colspan="3" style="color: var(--muted);">
								Новин ще немає.
							</td>
						</tr>
					) : (
						items.map((item) => (
							<tr>
								<td>
									<a href={`/app/admin/content/news/${item.id}`}>{item.title.uk}</a>
								</td>
								<td style="font-family: var(--font-mono); font-size: 12px; color: var(--muted);">{item.slug}</td>
								<td>{item.date}</td>
							</tr>
						))
					)
				}
			</tbody>
		</table>
	</div>
</AppLayout>
