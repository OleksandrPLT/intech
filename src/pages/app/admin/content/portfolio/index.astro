---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { getPortfolio } from '../../../../../data/portfolio';

const user = Astro.locals.user!;
const items = getPortfolio();
---

<AppLayout user={user} title="Портфоліо">
	<div class="app-header">
		<h1>Портфоліо</h1>
		<a href="/app/admin/content/portfolio/new" class="btn btn--primary">+ Новий проект</a>
	</div>

	<div class="card table-wrap">
		<table class="data-table">
			<thead>
				<tr>
					<th>Назва (UA)</th>
					<th>URL</th>
					<th>Теги</th>
				</tr>
			</thead>
			<tbody>
				{
					items.length === 0 ? (
						<tr>
							<td colspan="3" style="color: var(--muted);">
								Ще немає проектів.
							</td>
						</tr>
					) : (
						items.map((item) => (
							<tr>
								<td>
									<a href={`/app/admin/content/portfolio/${item.id}`}>{item.title.uk}</a>
								</td>
								<td style="font-size: 13px; color: var(--muted);">{item.url}</td>
								<td>{item.tags?.join(', ')}</td>
							</tr>
						))
					)
				}
			</tbody>
		</table>
	</div>
</AppLayout>
