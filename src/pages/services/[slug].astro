---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { getServices, getService } from '../../data/services';
import { useTranslations, localeUrl } from '../../i18n/utils';

const lang = 'uk' as const;
const t = useTranslations(lang);
const { slug } = Astro.params;
const service = slug ? getService(slug) : undefined;

if (!service) {
	return Astro.redirect(localeUrl(lang, '/services'));
}

const content = service.uk;
const otherServices = getServices().filter((s) => s.slug !== service.slug);
---

<BaseLayout lang={lang} title={`${content.title} — intech.org.ua`} description={content.summary}>
	<section class="section detail-hero">
		<div class="container">
			<a href={localeUrl(lang, '/services')} class="back-link">← {t('services.back')}</a>
			<div class="detail-hero__row">
				<div class="detail-hero__icon">
					<ServiceIcon name={service.icon} />
				</div>
				<div>
					<h1>{content.title}</h1>
					<p class="detail-hero__summary">{content.summary}</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section section--tight">
		<div class="container detail-grid">
			<div class="detail-main">
				<p class="detail-description">{content.description}</p>

				<h2 class="detail-subhead">{t('services.included')}</h2>
				<ul class="check-list">
					{content.features.map((f) => <li>{f}</li>)}
				</ul>
			</div>

			<aside class="detail-aside card">
				<h3>{t('services.forWhom')}</h3>
				<ul class="dot-list">
					{content.forWhom.map((f) => <li>{f}</li>)}
				</ul>
				<a href={localeUrl(lang, '/contact')} class="btn btn--primary detail-aside__cta">
					{t('home.hero.ctaPrimary')}
				</a>
			</aside>
		</div>
	</section>

	<section class="section section--tight other-services">
		<div class="container">
			<span class="eyebrow">{t('services.title')}</span>
			<ul class="other-services__list">
				{
					otherServices.map((s) => (
						<li>
							<a href={localeUrl(lang, `/services/${s.slug}`)}>{s.uk.title}</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.detail-hero {
		padding-bottom: 0;
	}

	.back-link {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--muted);
		margin-bottom: 32px;
	}

	.back-link:hover {
		color: var(--accent);
	}

	.detail-hero__row {
		display: flex;
		align-items: flex-start;
		gap: 24px;
	}

	.detail-hero__icon {
		flex: none;
		width: 64px;
		height: 64px;
		border-radius: 16px;
		background: var(--ink-soft);
		color: var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.detail-hero__icon svg {
		width: 30px;
		height: 30px;
	}

	h1 {
		font-size: clamp(28px, 4vw, 42px);
	}

	.detail-hero__summary {
		font-size: 18px;
		max-width: 560px;
		margin: 0;
	}

	.detail-grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: 48px;
		align-items: start;
	}

	.detail-description {
		font-size: 17px;
		color: var(--paper);
		max-width: 640px;
	}

	.detail-subhead {
		font-size: 20px;
		margin-top: 40px;
	}

	.check-list {
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 560px;
	}

	.check-list li {
		position: relative;
		padding-left: 28px;
		color: var(--paper);
		font-size: 15px;
	}

	.check-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 7px;
		width: 14px;
		height: 14px;
		border-radius: 4px;
		background: var(--accent);
	}

	.detail-aside {
		padding: 32px;
		position: sticky;
		top: 100px;
	}

	.detail-aside h3 {
		font-size: 16px;
		margin-bottom: 20px;
	}

	.dot-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.dot-list li {
		position: relative;
		padding-left: 18px;
		font-size: 14px;
		color: var(--muted);
	}

	.dot-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 8px;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent-secondary);
	}

	.detail-aside__cta {
		display: flex;
		justify-content: center;
		margin-top: 28px;
		width: 100%;
	}

	.other-services {
		border-top: 1px solid var(--border);
	}

	.other-services__list {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 20px;
	}

	.other-services__list a {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 13px;
		padding: 10px 18px;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--muted);
	}

	.other-services__list a:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	@media (max-width: 860px) {
		.detail-grid {
			grid-template-columns: 1fr;
		}
		.detail-aside {
			position: static;
		}
	}

	@media (max-width: 560px) {
		.detail-hero__row {
			flex-direction: column;
		}
	}
</style>
