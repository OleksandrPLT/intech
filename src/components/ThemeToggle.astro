---
interface Props {
	size?: 'sm' | 'md';
}
const { size = 'md' } = Astro.props;
---

<label class:list={['theme-toggle', `theme-toggle--${size}`]} title="Світла / темна тема">
	<input type="checkbox" id="theme-toggle-input" class="theme-toggle__input" />
	<span class="theme-toggle__track">
		<svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
			<path d="M21 12.5A8.5 8.5 0 1111.5 3a6.5 6.5 0 009.5 9.5z" />
		</svg>
		<svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="4.5" />
			<path d="M12 2.5v2.5M12 19v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12H5M19 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" />
		</svg>
		<span class="theme-toggle__thumb" aria-hidden="true"></span>
	</span>
	<span class="visually-hidden">Перемкнути світлу/темну тему</span>
</label>

<script>
	const input = document.getElementById('theme-toggle-input') as HTMLInputElement | null;
	if (input) {
		input.checked = document.documentElement.getAttribute('data-theme') === 'light';
		input.addEventListener('change', () => {
			const theme = input.checked ? 'light' : 'dark';
			document.documentElement.setAttribute('data-theme', theme);
			try {
				localStorage.setItem('theme', theme);
			} catch {
				// localStorage unavailable (private mode, etc.) — theme just won't persist.
			}
		});
	}
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		cursor: pointer;
	}

	.theme-toggle__input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.theme-toggle__track {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		box-sizing: border-box;
		width: 52px;
		height: 28px;
		padding: 0 6px;
		border-radius: 999px;
		background: var(--ink-soft);
		border: 1px solid var(--border);
		flex: none;
	}

	.theme-toggle--sm .theme-toggle__track {
		width: 44px;
		height: 24px;
		padding: 0 5px;
	}

	.theme-toggle__icon {
		position: relative;
		z-index: 1;
		flex: none;
		width: 14px;
		height: 14px;
		color: var(--muted);
		transition: color 0.15s ease;
	}

	.theme-toggle--sm .theme-toggle__icon {
		width: 11px;
		height: 11px;
	}

	.theme-toggle__thumb {
		position: absolute;
		top: 2px;
		left: 2px;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 1px 3px color-mix(in srgb, var(--ink) 40%, transparent);
		transition: transform 0.2s ease;
	}

	.theme-toggle--sm .theme-toggle__thumb {
		width: 18px;
		height: 18px;
	}

	.theme-toggle__input:checked ~ .theme-toggle__track .theme-toggle__thumb {
		transform: translateX(26px);
	}

	.theme-toggle--sm .theme-toggle__input:checked ~ .theme-toggle__track .theme-toggle__thumb {
		transform: translateX(22px);
	}

	.theme-toggle__input:checked ~ .theme-toggle__track .theme-toggle__icon--sun {
		color: var(--on-accent);
	}

	.theme-toggle__input:not(:checked) ~ .theme-toggle__track .theme-toggle__icon--moon {
		color: var(--on-accent);
	}

	.theme-toggle__input:focus-visible ~ .theme-toggle__track {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
</style>
