---
import { techStack } from '../data/techStack';
import type { Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

// Eagerly import every logo SVG as raw markup, keyed by filename (without extension).
const logoModules = import.meta.glob('../assets/logos/*.svg', {
	query: '?raw',
	import: 'default',
	eager: true,
}) as Record<string, string>;

function getLogo(slug?: string): string | undefined {
	if (!slug) return undefined;
	const entry = Object.entries(logoModules).find(([path]) => path.endsWith(`/${slug}.svg`));
	return entry?.[1];
}
---

<div class="tech-stack">
	{
		techStack.map((category) => (
			<div class="tech-stack__group">
				<span class="tech-stack__label">{category.label[lang]}</span>
				<ul class="tech-stack__list">
					{category.items.map((item) => {
						const svg = getLogo(item.logo);
						return (
							<li class="tech-badge">
								{svg ? (
									<span class="tech-badge__icon" set:html={svg} />
								) : (
									<span class="tech-badge__icon tech-badge__icon--dot" aria-hidden="true" />
								)}
								<span>{item.name}</span>
							</li>
						);
					})}
				</ul>
			</div>
		))
	}
</div>

<style>
	.tech-stack {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.tech-stack__label {
		display: block;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 12px;
	}

	.tech-stack__list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.tech-badge {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		padding: 9px 16px;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 14px;
		color: var(--paper);
		background: var(--ink-soft);
	}

	.tech-badge__icon {
		display: flex;
		width: 16px;
		height: 16px;
		color: var(--accent);
		flex: none;
	}

	.tech-badge__icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	.tech-badge__icon--dot {
		width: 8px;
		height: 8px;
		margin: 4px;
		border-radius: 50%;
		background: var(--accent-secondary);
	}
</style>
