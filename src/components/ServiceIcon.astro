---
interface Props {
	name: 'web' | 'crm' | 'custom' | 'vpn' | 'server' | 'redesign' | 'email' | 'bot';
	class?: string;
}

const { name, class: className } = Astro.props;
---

{
	name === 'web' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<rect x="3" y="5" width="18" height="14" rx="2" />
			<line x1="3" y1="9" x2="21" y2="9" />
			<circle cx="6" cy="7" r="0.5" fill="currentColor" stroke="none" />
			<circle cx="8.4" cy="7" r="0.5" fill="currentColor" stroke="none" />
			<circle cx="10.8" cy="7" r="0.5" fill="currentColor" stroke="none" />
		</svg>
	)
}

{
	name === 'crm' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<rect x="3" y="4" width="18" height="16" rx="2" />
			<circle cx="8.5" cy="10" r="2.1" />
			<path d="M5.3,16.8 a3.2,3.2 0 0 1 6.4,0" />
			<line x1="13.5" y1="8" x2="18" y2="8" />
			<line x1="13.5" y1="11" x2="18" y2="11" />
			<line x1="13.5" y1="14" x2="16.5" y2="14" />
		</svg>
	)
}

{
	name === 'custom' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<line x1="3" y1="7" x2="21" y2="7" />
			<circle cx="14" cy="7" r="2" />
			<line x1="3" y1="12" x2="21" y2="12" />
			<circle cx="8" cy="12" r="2" />
			<line x1="3" y1="17" x2="21" y2="17" />
			<circle cx="16" cy="17" r="2" />
		</svg>
	)
}

{
	name === 'vpn' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12,3 L19,6 V11 C19,16 16,19.5 12,21 C8,19.5 5,16 5,11 V6 Z" />
			<rect x="9.5" y="12" width="5" height="4.2" rx="1" />
			<path d="M10.5,12 V10.4 a1.5,1.5 0 0 1 3,0 V12" />
		</svg>
	)
}

{
	name === 'server' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<rect x="3" y="4" width="18" height="6" rx="1.5" />
			<rect x="3" y="14" width="18" height="6" rx="1.5" />
			<circle cx="7" cy="7" r="0.7" fill="currentColor" stroke="none" />
			<circle cx="7" cy="17" r="0.7" fill="currentColor" stroke="none" />
			<line x1="11" y1="7" x2="17" y2="7" />
			<line x1="11" y1="17" x2="17" y2="17" />
		</svg>
	)
}

{
	name === 'email' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<rect x="3" y="5" width="18" height="14" rx="2" />
			<path d="M4,7 L12,13 L20,7" />
		</svg>
	)
}

{
	name === 'bot' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<rect x="5" y="8" width="14" height="11" rx="3" />
			<line x1="12" y1="8" x2="12" y2="4" />
			<circle cx="12" cy="3" r="1.1" fill="currentColor" stroke="none" />
			<circle cx="9.2" cy="13.2" r="1" fill="currentColor" stroke="none" />
			<circle cx="14.8" cy="13.2" r="1" fill="currentColor" stroke="none" />
			<line x1="9" y1="17" x2="15" y2="17" />
		</svg>
	)
}

{
	name === 'redesign' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M4,12a8,8 0 0 1 14.5,-4.5" />
			<path d="M19,4v5h-5" />
			<path d="M20,12a8,8 0 0 1 -14.5,4.5" />
			<path d="M5,20v-5h5" />
		</svg>
	)
}
