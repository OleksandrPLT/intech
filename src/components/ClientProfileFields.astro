---
import { countries } from '../lib/countries';

interface Props {
	values?: {
		phone?: string | null;
		companyName?: string | null;
		legalAddress?: string | null;
		taxId?: string | null;
		country?: string | null;
		preferredLanguage?: string | null;
		adminNotes?: string | null;
	};
}

const v = Astro.props.values ?? {};
const languageLabels: Record<string, string> = { uk: 'Українська', en: 'English', et: 'Eesti' };
---

<div class="field">
	<label for="phone">Телефон</label>
	<input type="tel" id="phone" name="phone" value={v.phone ?? ''} placeholder="+380 XX XXX XX XX" data-phone-mask inputmode="tel" />
</div>
<div class="field">
	<label for="companyName">Назва компанії</label>
	<input type="text" id="companyName" name="companyName" value={v.companyName ?? ''} />
</div>
<div class="field">
	<label for="legalAddress">Юридична адреса</label>
	<input type="text" id="legalAddress" name="legalAddress" value={v.legalAddress ?? ''} />
</div>
<div class="field">
	<label for="taxId">ЄДРПОУ / РНОКПП</label>
	<input type="text" id="taxId" name="taxId" value={v.taxId ?? ''} />
</div>
<div class="field">
	<label for="country">Країна</label>
	<select id="country" name="country">
		<option value="">— не вказано —</option>
		{
			countries.map((c) => (
				<option value={c.code} selected={c.code === v.country}>
					{c.name}
				</option>
			))
		}
	</select>
</div>
<div class="field">
	<label for="preferredLanguage">Мова спілкування</label>
	<select id="preferredLanguage" name="preferredLanguage">
		<option value="">— не вказано —</option>
		{
			(['uk', 'en', 'et'] as const).map((lang) => (
				<option value={lang} selected={lang === v.preferredLanguage}>
					{languageLabels[lang]}
				</option>
			))
		}
	</select>
</div>
<div class="field" style="grid-column: 1 / -1;">
	<label for="adminNotes">Приватні нотатки адміна — клієнт їх не бачить</label>
	<textarea id="adminNotes" name="adminNotes">{v.adminNotes ?? ''}</textarea>
</div>

<script>
	// Ukrainian phone mask: formats to "+380 XX XXX XX XX" as the admin
	// types, whatever they actually type (with/without +, 0, spaces, …).
	document.querySelectorAll<HTMLInputElement>('input[data-phone-mask]').forEach((input) => {
		input.addEventListener('input', () => {
			let digits = input.value.replace(/\D/g, '');
			if (!digits) {
				input.value = '';
				return;
			}
			if (digits.startsWith('0')) digits = '380' + digits.slice(1);
			else if (!digits.startsWith('380')) digits = '380' + digits;
			digits = digits.slice(0, 12);

			const rest = digits.slice(3);
			let formatted = '+380';
			if (rest.length) formatted += ' ' + rest.slice(0, 2);
			if (rest.length > 2) formatted += ' ' + rest.slice(2, 5);
			if (rest.length > 5) formatted += ' ' + rest.slice(5, 7);
			if (rest.length > 7) formatted += ' ' + rest.slice(7, 9);
			input.value = formatted;
		});
	});
</script>
