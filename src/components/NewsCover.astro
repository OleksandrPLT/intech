---
interface Props {
	image?: string;
	icon?: string;
	title: string;
	compact?: boolean;
}

const { image, icon, title, compact = false } = Astro.props;

const icons: Record<string, string> = {
	launch:
		'M12 2c2.5 2 4 5.5 4 9.5 0 2-.5 3.7-1.2 5.1M12 2c-2.5 2-4 5.5-4 9.5 0 2 .5 3.7 1.2 5.1M9.2 16.6L7 21l3.3-1.8M14.8 16.6L17 21l-3.3-1.8M9.5 11.5a2.5 2.5 0 105 0 2.5 2.5 0 00-5 0z',
	globe:
		'M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c2.2 2.3 3.5 5.6 3.5 9s-1.3 6.7-3.5 9c-2.2-2.3-3.5-5.6-3.5-9S9.8 5.3 12 3z',
	default: 'M4 4h13l3 4-3 4H4V4zM4 12v8',
};
const path = icons[icon ?? ''] ?? icons.default;
---

<div class:list={['news-cover', { 'news-cover--compact': compact }]}>
	{
		image ? (
			<img src={image} alt="" loading="lazy" />
		) : (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d={path} />
			</svg>
		)
	}
</div>

<style>
	.news-cover {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--accent) 16%, var(--ink-softer)), var(--ink-softer) 65%);
		border: 1px solid var(--border);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.news-cover--compact {
		aspect-ratio: 4 / 3;
	}

	.news-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.news-cover svg {
		width: 34%;
		height: 34%;
		color: var(--accent);
		opacity: 0.85;
	}
</style>
