---
import { sortedNews } from '../data/news';
import NewsCover from './NewsCover.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations, localeUrl } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const latest = sortedNews().slice(0, 3);
---

{
	latest.length > 0 && (
		<section class="section section--tight news-section">
			<div class="container">
				<div class="news-section__head">
					<div>
						<span class="eyebrow">{t('news.eyebrow')}</span>
						<h2>{t('news.title')}</h2>
					</div>
					<a href={localeUrl(lang, '/news')} class="btn btn--ghost">
						{t('services.viewAll')}
					</a>
				</div>

				<div class="news-grid">
					{latest.map((item) => (
						<a href={localeUrl(lang, `/news/${item.slug}`)} class="card news-card">
							<NewsCover image={item.image} icon={item.icon} title={item.title[lang]} compact />
							<div class="news-card__body">
								<time class="news-card__date" datetime={item.date}>
									{new Date(item.date).toLocaleDateString(lang === 'uk' ? 'uk-UA' : lang === 'et' ? 'et-EE' : 'en-GB', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</time>
								<h3 class="news-card__title">{item.title[lang]}</h3>
								<p class="news-card__excerpt">{item.excerpt[lang]}</p>
								<span class="news-card__link">{t('news.readMore')} →</span>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>
	)
}

<style>
	.news-section__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 32px;
		flex-wrap: wrap;
	}

	.news-section__head h2 {
		margin: 12px 0 0;
		font-size: clamp(24px, 3vw, 32px);
	}

	.news-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.news-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition: border-color 0.15s ease, transform 0.15s ease;
	}

	.news-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.news-card :global(.news-cover) {
		border-radius: 0;
		border-width: 0 0 1px;
	}

	.news-card__body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 24px;
	}

	.news-card__date {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted);
	}

	.news-card__title {
		font-size: 17px;
		margin: 0;
	}

	.news-card__excerpt {
		font-size: 14px;
		margin: 0;
		flex-grow: 1;
	}

	.news-card__link {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--paper);
	}

	.news-card:hover .news-card__link {
		color: var(--accent);
	}

	@media (max-width: 860px) {
		.news-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 620px) {
		.news-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
