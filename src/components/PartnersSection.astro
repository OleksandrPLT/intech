---
import { partners } from '../data/partners';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

{
	partners.length > 0 && (
		<section class="section section--tight partners-section">
			<div class="container">
				<span class="eyebrow">{t('home.partners.eyebrow')}</span>
				<h2>{t('home.partners.title')}</h2>
				<div class="partners-row">
					{partners.map((p) => (
						<a href={p.url} target="_blank" rel="noopener noreferrer" class="partners-row__item" title={p.name}>
							<img src={p.logo} alt={p.name} loading="lazy" />
						</a>
					))}
				</div>
			</div>
		</section>
	)
}

<style>
	.partners-section h2 {
		font-size: clamp(24px, 3vw, 32px);
		margin: 12px 0 32px;
	}

	.partners-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 20px;
	}

	.partners-row__item {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 96px;
		height: 64px;
		padding: 12px;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border);
		background: var(--ink-soft);
		filter: grayscale(1);
		opacity: 0.75;
		transition: opacity 0.15s ease, filter 0.15s ease;
	}

	.partners-row__item:hover {
		opacity: 1;
		filter: grayscale(0);
	}

	.partners-row__item img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}

	@media (max-width: 620px) {
		.partners-row {
			gap: 14px;
		}
		.partners-row__item {
			width: 84px;
			height: 56px;
		}
	}
</style>
