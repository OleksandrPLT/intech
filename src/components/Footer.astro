---
import Logo from './Logo.astro';
import { getServices } from '../data/services';
import { useTranslations, localeUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const services = getServices();
---

<footer class="footer">
	<div class="container footer__inner">
		<div class="footer__brand">
			<Logo href={localeUrl(lang, '/')} size="sm" tagline />
			<p class="footer__tagline">{t('footer.tagline')}</p>
		</div>

		<div class="footer__col">
			<span class="eyebrow">{t('footer.services')}</span>
			<ul>
				{
					services.map((service) => (
						<li>
							<a href={localeUrl(lang, `/services/${service.slug}`)}>{service[lang].title}</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="footer__col">
			<span class="eyebrow">{t('footer.company')}</span>
			<ul>
				<li><a href={localeUrl(lang, '/about')}>{t('nav.about')}</a></li>
				<li><a href={localeUrl(lang, '/portfolio')}>{t('nav.portfolio')}</a></li>
				<li><a href={localeUrl(lang, '/news')}>{t('nav.news')}</a></li>
				<li><a href={localeUrl(lang, '/contact')}>{t('nav.contact')}</a></li>
				<li><a href={localeUrl(lang, '/services')}>{t('nav.services')}</a></li>
			</ul>
		</div>
	</div>

	<div class="container footer__bottom">
		<span>© {year} intech.org.ua — {t('footer.rights')}</span>
		<span>{t('contact.location')}</span>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--border);
		padding: 64px 0 32px;
	}

	.footer__inner {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr;
		gap: 48px;
	}

	.footer__brand {
		max-width: 320px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.footer__tagline {
		margin: 0;
		font-size: 14px;
	}

	.footer__col ul {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-top: 16px;
	}

	.footer__col a {
		font-size: 14px;
		color: var(--muted);
	}

	.footer__col a:hover {
		color: var(--paper);
	}

	.footer__bottom {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 56px;
		padding-top: 24px;
		border-top: 1px solid var(--border);
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.footer__inner {
			grid-template-columns: 1fr 1fr;
		}
		.footer__brand {
			grid-column: 1 / -1;
			max-width: none;
		}
	}
</style>
